# Path to the canonical SQLite database. Defaults to ./data/pcf.db.
# PCF_DB_PATH=./data/pcf.db

# Reserved for a later optional model override (SPEC.md §16). Not read in v0.1:
# your Claude Code default model is used.
# PCF_CLAUDE_MODEL=

# No Anthropic API key is used or read by this application (SPEC.md §16, §34).
# AI features use your logged-in Claude Code subscription through the installed `claude` CLI.
